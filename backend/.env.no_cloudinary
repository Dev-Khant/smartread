# SmartRead Configuration (No Cloudinary Version)

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
WORKERS=1

# Required API Keys
MISTRAL_API_KEY=your_mistral_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Optional: For search functionality (if you want related articles/videos)
SERPER_API_KEY=your_serper_api_key_here

# Database Configuration
MONGODB_URL=mongodb://localhost:27017/smartread

# Optional: Redis for caching (improves performance)
REDIS_URL=redis://localhost:6379

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage Configuration (Local Storage)
STORAGE_TYPE=local

# Feature Flags
USE_ASYNC_ROUTES=false
ENABLE_CACHING=false
ENABLE_RATE_LIMITING=false

# Performance Settings
MAX_CONCURRENT_PAGES=3
MAX_RETRIES=3

# Note: Cloudinary variables are not needed for this version
# All files will be stored locally in the 'storage' directory
