# SmartRead Enhanced Configuration

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
WORKERS=1
LOG_LEVEL=info

# Processing Mode Selection
# Options: auto, enhanced, async, original
# auto: Automatically select based on available API keys
# enhanced: Use Gemini + Tavily (requires GEMINI_API_KEY + TAVILY_API_KEY)
# async: Use Mistral + Groq with async processing (requires MISTRAL_API_KEY + GROQ_API_KEY)
# original: Use original Mistral + Groq (requires MISTRAL_API_KEY + GROQ_API_KEY)
PROCESSING_MODE=auto

# AI API Keys
# Gemini (Google AI) - For enhanced document processing
GEMINI_API_KEY=your_gemini_api_key_here

# Mistral AI - For OCR processing
MISTRAL_API_KEY=your_mistral_api_key_here

# Groq - For text processing
GROQ_API_KEY=your_groq_api_key_here

# Search API Keys
# Tavily - Enhanced search (recommended)
TAVILY_API_KEY=your_tavily_api_key_here

# Serper - Alternative search (legacy)
SERPER_API_KEY=your_serper_api_key_here

# Database Configuration
MONGODB_URL=mongodb://localhost:27017/smartread
REDIS_URL=redis://localhost:6379

# Cloudinary Configuration (for file storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Feature Flags
USE_ASYNC_ROUTES=true
ENABLE_CACHING=true
ENABLE_RATE_LIMITING=true

# Performance Settings
MAX_CONCURRENT_PAGES=3
MAX_RETRIES=3
CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=1/minute

# Gemini Specific Settings
GEMINI_MODEL=flash  # Options: flash, pro, flash_thinking
GEMINI_CACHE_TTL=24  # Hours

# Tavily Specific Settings
TAVILY_SEARCH_DEPTH=basic  # Options: basic, advanced
TAVILY_MAX_RESULTS=5
